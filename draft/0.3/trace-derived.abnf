; SPDX-License-Identifier: Apache-2.0
; OSTF 0.3 working draft, Annex B.2 (normative, optional): trace.derived grammar.
; RFC 5234 ABNF with RFC 7405 case-sensitive literals. The file is a
; sequence of octets. Semantic constraints that the grammar does not
; express: a percent-decoded value is valid UTF-8; an observation holds
; view and tool once each; a writer escapes the octets that safe-octet
; excludes, writes view before tool, sorts lines by their bytes, ends
; every line with LF and writes no empty line. Readers accept CRLF,
; unsorted input and lowercase hex.

derived-file = %s"trace.derived 1" *( newline [ observation ] )
observation  = source SP %s"covers" SP target 2( SP derived-pair )
derived-pair = ( %s"view" / %s"tool" ) "=" 1*( safe-octet / escape )
source       = 1*( safe-octet / escape )
target       = 1*( safe-octet / escape )
escape       = "%" HEXDIG HEXDIG
safe-octet   = %x21-24 / %x26-3C / %x3E-7E / %x80-FF
newline      = CRLF / LF
