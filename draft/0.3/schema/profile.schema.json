{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostf.dev/draft/0.3/profile.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. OSTF 0.3 working draft, OSTF-121. Structural shape of a profile file. Entries named like default types or links merge over the default definition; a new link needs from and to, which the reader checks semantically.",
  "title": "OSTF profile file",
  "type": "object",
  "properties": {
    "ostf": { "const": "0.3" },
    "types": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9-]{0,47}$" },
      "properties": {
        "need": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "statement" } } },
        "requirement": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "statement" } } },
        "design": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "statement" } } },
        "control": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "statement" } } },
        "risk": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "risk" } } },
        "threat": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "risk" } } },
        "verification": { "$ref": "#/$defs/type", "properties": { "kind": { "const": "verification" } } }
      },
      "additionalProperties": { "$ref": "#/$defs/type", "required": ["kind"], "$comment": "A new type declares its kind (OSTF-121)." }
    },
    "links": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,47}$" },
      "additionalProperties": { "$ref": "#/$defs/link" }
    }
  },
  "required": ["ostf"],
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "attributeName": { "pattern": "^[A-Za-z][A-Za-z0-9]{0,47}$" },
    "values": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "type": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["statement", "risk", "verification"], "$comment": "A default type keeps its own (OSTF-120)." },
        "description": { "type": "string" },
        "attributes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/attributeName" },
          "additionalProperties": { "$ref": "#/$defs/attribute" }
        }
      },
      "additionalProperties": false
    },
    "attribute": {
      "type": "object",
      "properties": {
        "type": { "enum": ["string", "text", "number", "boolean", "list"] },
        "values": { "$ref": "#/$defs/values" },
        "required": { "type": "boolean" },
        "meaning": { "type": "boolean" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^(code|tests|[a-z][a-z0-9-]{0,47})$" }
    },
    "linkAttribute": {
      "type": "object",
      "properties": {
        "values": { "$ref": "#/$defs/values" },
        "required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "description": { "type": "string" },
        "from": { "$ref": "#/$defs/endpoints" },
        "to": { "$ref": "#/$defs/endpoints" },
        "acyclic": { "type": "boolean" },
        "inverse": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
        "attributes": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/attributeName", "not": { "enum": ["to", "ref", "source", "target", "by", "at"] } },
          "additionalProperties": { "$ref": "#/$defs/linkAttribute" }
        }
      },
      "additionalProperties": false
    }
  }
}
