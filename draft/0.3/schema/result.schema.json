{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ostf.dev/draft/0.3/result.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0. OSTF 0.3 working draft, Annex D.2 and D.3. Shape of a result: a conformance result, or the json output of check and context (Annex F). Sort orders, omission rules and comparison rules are in ostf.md.",
  "title": "OSTF result",
  "type": "object",
  "properties": {
    "ostf": { "const": "0.3" },
    "context": { "type": "string", "minLength": 1, "$comment": "Present only in a context result: TARGET as given (Annex F.3)." },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
    "impact": { "$ref": "#/$defs/impact" }
  },
  "required": ["ostf", "diagnostics", "items", "links"],
  "patternProperties": { "^x-": {} },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$" },
    "anchor": {
      "type": "string",
      "pattern": "^[^/\\\\\\r\\n#][^\\\\\\r\\n#]*(#[^\\r\\n]+)?$"
    },
    "ids": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "identities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "$comment": "Link identity: source, link type, target and attribute pairs, escaped (Annex F.2)." }
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
        "severity": { "enum": ["error", "warning", "info"] },
        "file": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "hint": { "type": "string" }
      },
      "required": ["code", "severity"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
        "status": { "enum": ["draft", "accepted", "obsolete"] },
        "riskRelevant": { "type": "boolean" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "rationale": { "type": "string" },
        "external": { "type": "string" },
        "revision": { "type": "string" }
      },
      "required": ["id", "type", "status", "riskRelevant"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "link": {
      "type": "object",
      "properties": {
        "source": { "type": "string", "minLength": 1, "$comment": "An item ID or an anchor." },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,47}$" },
        "target": { "$ref": "#/$defs/id" },
        "attributes": { "type": "object", "additionalProperties": { "type": "string" } },
        "origin": { "enum": ["declared", "tagged"] },
        "corroboration": { "enum": ["corroborated", "uncorroborated", "unobserved"], "$comment": "Annex E.3, optional: beside the link." },
        "observedIn": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "$comment": "Annex E.3: the views of the trace.derived lines that corroborate the link, in byte order, beside corroborated only." },
        "sourceChangedIn": { "type": "string", "minLength": 1, "$comment": "Annex F.3: the view identifier of the last commit that changed the source." },
        "targetChangedIn": { "type": "string", "minLength": 1, "$comment": "Annex F.3: the view identifier of the last commit that changed the target." }
      },
      "required": ["source", "type", "target", "attributes", "origin"],
      "dependentSchemas": { "observedIn": { "required": ["corroboration"], "properties": { "corroboration": { "const": "corroborated" } } } },
      "if": { "required": ["corroboration"], "properties": { "corroboration": { "const": "corroborated" } } },
      "then": { "required": ["observedIn"] },
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    },
    "impact": {
      "type": "object",
      "properties": {
        "base": { "type": "string", "minLength": 1 },
        "coverage": { "const": "direct" },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "anchor": { "$ref": "#/$defs/anchor" },
              "items": { "$ref": "#/$defs/ids" }
            },
            "required": ["anchor", "items"],
            "additionalProperties": false
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "context": { "$ref": "#/$defs/anchor" },
              "items": { "$ref": "#/$defs/ids" },
              "links": { "$ref": "#/$defs/identities" }
            },
            "required": ["context", "items", "links"],
            "additionalProperties": false,
            "$comment": "The context (Annex F.3) of a changed anchor; its items carry their details in the result's items (D.3)."
          }
        },
        "items": {
          "type": "object",
          "properties": {
            "added": { "$ref": "#/$defs/ids" },
            "changed": { "$ref": "#/$defs/ids" },
            "removed": { "$ref": "#/$defs/ids" }
          },
          "required": ["added", "changed", "removed"],
          "additionalProperties": false
        },
        "links": {
          "type": "object",
          "properties": {
            "added": { "$ref": "#/$defs/identities" },
            "removed": { "$ref": "#/$defs/identities" }
          },
          "required": ["added", "removed"],
          "additionalProperties": false
        },
        "tests": { "type": "array", "items": { "$ref": "#/$defs/anchor" } }
      },
      "required": ["base", "coverage", "changed", "contexts", "items", "links", "tests"],
      "patternProperties": { "^x-": {} },
      "additionalProperties": false
    }
  }
}
